# Copy to .env. Nothing here is required: visitors enter their own OpenRouter API key on the site,
# and it is used only for their analysis (never stored). The four rule-based measures run without any key.
SCISLOP_MODEL=openai/gpt-5.6-luna
# Optional, for local runs only: an OpenAI-compatible endpoint used when a visitor gives no key.
# SCISLOP_LLM_BASE_URL=http://localhost:8000/v1
# SCISLOP_REASONING=low
